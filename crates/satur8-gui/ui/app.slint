// Satur8 GUI. Layout, color, type and spacing follow the "game cards" renders
// (render-source/toolkit.py, card_revision.py, directions.py in the test copy).

import "fonts/SchibstedGrotesk-Bold.ttf";
import "fonts/HankenGrotesk-Regular.ttf";
import "fonts/HankenGrotesk-Medium.ttf";
import "fonts/HankenGrotesk-SemiBold.ttf";
import "fonts/JetBrainsMono-Medium.ttf";

import { GameRow, SteamRow, HealthRowUi, LogRow, Pal, Font } from "theme.slint";
import { Gm, GameModeUi, GmGame, GmPick, GmPrompt } from "touch.slint";
export { GameRow, SteamRow, HealthRowUi, LogRow, Pal, Font, Gm, GmGame, GmPick, GmPrompt }

// Button styles from toolkit.py:78-92.
// kind: 0 solid teal, 1 sub, 2 flat (outline), 3 tint, 4 bare.
component Btn inherits Rectangle {
    in property <string> text;
    in property <int> kind: 1;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <image> trailing;
    in property <bool> has-trailing: false;
    in property <length> font-size: 13px;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px;
    opacity: root.enabled ? 1 : 0.5;
    width: row.preferred-width + 32px;
    border-radius: 7px;
    property <length> isz: root.height >= 30px ? 15px : 13px;
    property <color> ink: kind == 0 ? Pal.on-accent
        : kind == 3 ? Pal.accent
        : kind == 1 ? Pal.ink
        : Pal.soft;
    background: kind == 0 ? (touch.has-hover ? Pal.accent-2 : Pal.accent)
        : kind == 1 ? (touch.has-hover ? Pal.hover : Pal.raised)
        : kind == 3 ? (touch.has-hover ? Pal.accent-soft-2 : Pal.accent-soft)
        : (touch.has-hover ? Pal.hover : transparent);
    border-width: kind == 4 ? 0px : 1px;
    border-color: kind == 0 ? Pal.accent : kind == 3 ? Pal.accent-line : Pal.line;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon; colorize: root.ink;
                width: root.isz; height: root.isz;
            }
        }
        if root.text != "": Text {
            text: root.text;
            font-family: Font.bold; font-weight: Font.bold-weight;
            font-size: root.font-size;
            color: root.ink;
            vertical-alignment: center;
        }
        if root.has-trailing: VerticalLayout {
            alignment: center;
            Image {
                source: root.trailing; colorize: root.ink;
                width: root.isz; height: root.isz;
            }
        }
    }
}

// Top-bar tab: text only, teal underline when active (toolkit.py:140-143).
component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 64px;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        width: 100%; height: 100%;
        text: root.label;
        font-family: root.active ? Font.bold : Font.med;
        font-weight: root.active ? Font.bold-weight : Font.med-weight;
        font-size: 15px;
        color: root.active ? Pal.ink : (touch.has-hover ? Pal.soft : Pal.muted);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.active: Rectangle {
        x: 9px; y: 61px; width: root.width - 18px; height: 3px;
        border-radius: 1px;
        background: Pal.accent;
    }
}

// Saturation toggle, 32x18 (toolkit.py:98-100).
component VibSwitch inherits Rectangle {
    in-out property <bool> checked;
    // controlled: the click only reports; the owner sets `checked` from the
    // real state, so the binding is never overwritten.
    in property <bool> controlled: false;
    in property <bool> enabled: true;
    callback toggled;
    width: 32px; height: 18px; border-radius: 9px;
    opacity: root.enabled ? 1 : 0.45;
    background: checked ? Pal.accent : Pal.field;
    border-width: 1px;
    border-color: checked ? Pal.accent : Pal.line;
    animate background { duration: 130ms; }
    Rectangle {
        width: 12px; height: 12px; border-radius: 6px;
        x: root.checked ? 16px : 3px;
        y: 3px;
        background: root.checked ? Pal.on-accent : Pal.soft;
        animate x { duration: 130ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        enabled: root.enabled;
        clicked => {
            if (!root.controlled) {
                root.checked = !root.checked;
            }
            root.toggled();
        }
    }
}

// Bipolar slider: the fill runs from the 0% center to the value
// (toolkit.py:101-118). ruler adds the 21 tick marks of the Desktop page.
component VibSlider inherits Rectangle {
    in property <float> minimum: -100;
    in property <float> maximum: 100;
    in-out property <float> value;
    in property <bool> ruler: false;
    callback changed(float);
    callback released(float);
    // Track center line inside this component.
    property <length> cy: 6px;
    property <float> frac: (root.value - root.minimum) / (root.maximum - root.minimum);
    property <length> pos: Math.floor(root.width * root.frac / 1px) * 1px;
    property <length> mid: Math.floor(root.width / 2px) * 1px;
    property <length> marks-y: root.ruler ? root.cy + 16px : root.cy + 9px;
    height: root.marks-y + 15px;

    function commit(px: length) {
        root.value = Math.clamp(
            root.minimum + (px / root.width) * (root.maximum - root.minimum),
            root.minimum, root.maximum);
        root.changed(root.value);
    }

    Rectangle {
        x: 0; y: root.cy - 2px; width: root.width; height: 4px;
        border-radius: 2px; background: Pal.field;
    }
    Rectangle {
        x: Math.min(root.mid, root.pos); y: root.cy - 2px;
        width: Math.max(1px, Math.abs(root.pos - root.mid)); height: 4px;
        border-radius: 2px; background: Pal.accent;
    }
    if !root.ruler: Rectangle {
        x: root.mid; y: root.cy - 4px; width: 1px; height: 8px;
        background: Pal.dim;
    }
    for t in (root.ruler ? 21 : 0): Rectangle {
        x: Math.round(t * root.width / 20 / 1px) * 1px;
        y: root.cy + 7px;
        width: 1px;
        height: Math.mod(t, 5) == 0 ? 7px : 3px;
        background: Math.mod(t, 5) == 0 ? Pal.dim : Pal.line;
    }
    Rectangle {
        x: root.pos - 6px; y: root.cy - 6px; width: 12px; height: 12px;
        border-radius: 6px; background: Pal.accent;
        Rectangle {
            x: 4px; y: 4px; width: 4px; height: 4px;
            border-radius: 2px; background: Pal.on-accent;
        }
    }
    Text {
        x: 0; y: root.marks-y; width: 50px; height: 15px;
        text: "-100%"; font-family: Font.mono; font-weight: Font.mono-weight; font-size: 10px; color: Pal.dim;
        vertical-alignment: center;
    }
    Text {
        x: root.mid - 25px; y: root.marks-y; width: 50px; height: 15px;
        text: "0%"; font-family: Font.mono; font-weight: Font.mono-weight; font-size: 10px; color: Pal.dim;
        horizontal-alignment: center; vertical-alignment: center;
    }
    Text {
        x: root.width - 50px; y: root.marks-y; width: 50px; height: 15px;
        text: "+100%"; font-family: Font.mono; font-weight: Font.mono-weight; font-size: 10px; color: Pal.dim;
        horizontal-alignment: right; vertical-alignment: center;
    }
    // `moved` fires on every pointer move while the button is held
    // (i-slint-core items/input_items.rs:179-187), so `changed` runs live
    // during a drag. `released` fires once when the drag ends.
    TouchArea {
        x: 0; y: 0; width: root.width; height: root.cy + 10px;
        mouse-cursor: pointer;
        moved => { root.commit(self.mouse-x); }
        clicked => { root.commit(self.mouse-x); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.released(root.value);
            }
        }
    }
}

// Section title (toolkit.py:188) and page heading (toolkit.py:122).
component Heading inherits Text {
    font-family: Font.head; font-weight: Font.head-weight;
    color: Pal.ink;
    letter-spacing: -0.55px;
    vertical-alignment: center;
}
component Section inherits Text {
    font-family: Font.head; font-weight: Font.head-weight;
    color: Pal.ink;
    letter-spacing: -0.25px;
    vertical-alignment: center;
}
component Para inherits Text {
    font-family: Font.reg; font-weight: Font.reg-weight;
    color: Pal.soft;
    wrap: word-wrap;
}

// One game profile card, 350x146 at the render size (card_revision.py:12-25).
component GameCard inherits Rectangle {
    in property <GameRow> game;
    // The card the "Add Steam game" picker just opened or added.
    in property <bool> picked: false;
    callback percent-changed(float);
    callback enabled-toggled(bool);
    callback remove-clicked();
    height: 146px;
    background: Pal.surface;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.picked ? Pal.accent-line : Pal.line;

    Rectangle {
        x: 15px; y: 12px; width: 35px; height: 35px;
        border-radius: 5px;
        clip: true;
        background: root.game.has-icon ? transparent : Pal.accent-soft;
        border-width: root.game.has-icon ? 0px : 1px;
        border-color: Pal.accent-line;
        if root.game.has-icon: Image {
            width: 100%; height: 100%;
            source: root.game.icon;
            image-fit: cover;
        }
        if !root.game.has-icon: Text {
            width: 100%; height: 100%;
            text: root.game.initial;
            font-family: Font.head; font-weight: Font.head-weight; font-size: 20px; color: Pal.accent;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    Text {
        x: 61px; y: 8px; width: root.width - 102px; height: 27px;
        text: root.game.name;
        font-family: Font.head; font-weight: Font.head-weight; font-size: 18px; color: Pal.ink;
        vertical-alignment: center; overflow: elide;
    }
    Text {
        x: 62px; y: 33px; width: root.width - 104px; height: 16px;
        text: root.game.exe;
        font-family: Font.mono; font-weight: Font.mono-weight; font-size: 11px; color: Pal.muted;
        vertical-alignment: center; overflow: elide;
    }
    Btn {
        x: root.width - 44px; y: 13px; width: 27px; height: 27px;
        kind: 4;
        has-icon: true; icon: @image-url("icons/x.svg");
        clicked => { root.remove-clicked(); }
    }
    Rectangle {
        x: 15px; y: 58px; width: root.width - 30px; height: 1px;
        background: Pal.line-soft;
    }
    Text {
        x: 15px; y: 65px; width: 91px; height: 23px;
        text: "Saturation";
        font-family: Font.med; font-weight: Font.med-weight; font-size: 13px; color: Pal.soft;
        vertical-alignment: center;
    }
    Text {
        x: 101px; y: 62px; width: 90px; height: 26px;
        text: (root.game.percent > 0 ? "+" : "") + root.game.percent + "%";
        font-family: Font.head; font-weight: Font.head-weight; font-size: 18px; color: Pal.accent;
        vertical-alignment: center;
    }
    Text {
        x: root.width - 110px; y: 65px; width: 55px; height: 22px;
        text: "Enabled";
        font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.muted;
        vertical-alignment: center;
    }
    VibSwitch {
        x: root.width - 48px; y: 68px;
        checked: root.game.enabled;
        toggled => { root.enabled-toggled(self.checked); }
    }
    VibSlider {
        x: 17px; y: 98px; width: root.width - 34px;
        minimum: -100; maximum: 100;
        value: root.game.percent;
        changed(v) => { root.percent-changed(v); }
    }
}

export component AppWindow inherits Window {
    title: "Satur8";
    icon: @image-url("icon.png");
    default-font-family: "Hanken Grotesk";
    default-font-size: 14px;
    // The size the window opens at. In a Steam gaming session main.rs sets
    // these to the whole output before the window is shown (src/mode.rs).
    in property <length> open-width: 1140px;
    in property <length> open-height: 700px;
    preferred-width: root.open-width;
    preferred-height: root.open-height;
    // A Steam gaming session gets its own layout (touch.slint), drawn 640
    // logical pixels wide (src/mode.rs). main.rs sets this before the window
    // is shown.
    in property <bool> touch: false;
    min-width: root.touch ? 640px : 1040px;
    min-height: root.touch ? 360px : 560px;
    background: Pal.bg;

    in-out property <[GameRow]> games;
    in-out property <[LogRow]> activity;
    in-out property <string> backend-name: "none";
    in-out property <bool> backend-ok: false;
    in-out property <string> version-text: "";
    in-out property <int> default-percent: 0;
    in-out property <int> nav: 0;


    // Status page.
    in-out property <[HealthRowUi]> health;
    in-out property <bool> health-problem: false;
    in-out property <bool> checking: false;
    in-out property <bool> repairing: false;
    in-out property <bool> switch-available: false;
    in-out property <bool> switch-on: false;
    in-out property <bool> switch-busy: false;
    in-out property <string> switch-detail: "Checking...";
    in-out property <bool> live-daemon: false;
    in-out property <string> live-profile: "-";
    in-out property <string> live-saturation: "-";
    in-out property <string> live-saturation-note: "";
    in-out property <bool> live-color-off: false;
    in-out property <bool> live-has-focused: false;
    in-out property <string> live-focused: "";
    in-out property <int> new-game-percent: 40;
    in-out property <string> sysinfo-text: "";
    callback check-health();
    callback repair();
    callback set-switching(bool);
    callback new-game-changed(float);
    callback new-game-released(float);
    callback sysinfo-copied();
    callback report-bug();
    callback page-shown(int);

    changed nav => { root.page-shown(root.nav); }

    callback default-changed(float);
    callback default-released(float);
    callback percent-changed(int, float);
    callback toggle-enabled(int, bool);
    callback remove(int);

    // The "Add game" list. Rust reads the Steam library and what is running
    // when it opens (and on Refresh) and fills these; the page only draws them.
    in-out property <[SteamRow]> steam-rows;
    in-out property <string> steam-message: "";
    in-out property <bool> steam-filter-shown: false;
    // The card to bring into view, and a count that changes on every pick so
    // picking the same card twice still scrolls to it.
    in-out property <int> picked-index: -1;
    in-out property <int> picked-serial: 0;
    callback steam-picker-opened();
    callback steam-refresh();
    callback steam-filter-changed(string);
    // Enter in the filter field; true when it picked a game.
    callback steam-filter-accepted() -> bool;
    callback pick-steam(int);      // the row's index in steam-rows
    callback clear-activity();
    callback dark-mode-changed(bool);
    callback open-link(string);

    property <length> page-h: root.height - 65px;

    // Main page geometry (page coordinates, below the 65px top bar).
    // Desktop strip, then the "Games" row, then the card grid and the note.
    // Cards keep the render's 15px column gap and 11px row gap; the column
    // count follows the window width so cards stay between 300px and about
    // 380px wide (350px at 1140px).
    property <length> strip-y: 24px;
    property <length> strip-h: 110px;
    property <length> games-y: root.strip-y + root.strip-h + 28px;
    property <length> grid-y: root.games-y + 37px + 16px;
    property <int> grid-cols: Math.max(1, Math.floor((root.width - 45px) / 315px));
    property <length> card-w: (root.width - 60px - (root.grid-cols - 1) * 15px) / root.grid-cols;
    property <int> grid-rows: Math.ceil(root.games.length / root.grid-cols);
    property <length> grid-h: root.grid-rows == 0 ? 146px : root.grid-rows * 157px - 11px;
    property <length> note-y: root.grid-y + root.grid-h + 10px;

    // ================= Top bar (toolkit.py:137-145) =================
    if !root.touch: Rectangle {
        x: 0; y: 0; width: root.width; height: 65px;
        background: Pal.sheet;
        Rectangle { x: 0; y: 64px; width: parent.width; height: 1px; background: Pal.line; }

        Image {
            x: 30px; y: 20px; width: 115px; height: 23px;
            source: Pal.dark ? @image-url("word.png") : @image-url("word-light.png");
            image-fit: fill;
        }
        Rectangle { x: 173px; y: 20px; width: 1px; height: 24px; background: Pal.line; }

        Tab { x: 194px; y: 0; width: 58px; label: "Main";     active: root.nav == 0; clicked => { root.nav = 0; } }
        Tab { x: 266px; y: 0; width: 66px; label: "Status";   active: root.nav == 1; clicked => { root.nav = 1; } }
        Tab { x: 346px; y: 0; width: 60px; label: "About";    active: root.nav == 2; clicked => { root.nav = 2; } }

        // Backend status pill. Right edge sits 141px from the window edge.
        Rectangle {
            y: 18px; height: 28px;
            width: Math.max(155px, pill-text.preferred-width + 39px);
            x: parent.width - 141px - self.width;
            border-radius: 14px;
            background: Pal.surface;
            border-width: 1px;
            border-color: Pal.line;
            Rectangle {
                x: 12px; y: 11px; width: 6px; height: 6px; border-radius: 3px;
                background: root.backend-ok ? Pal.accent : Pal.danger;
            }
            pill-text := Text {
                x: 25px; y: 0; height: 28px;
                text: root.backend-ok ? (root.backend-name + " backend active") : "no backend in this session";
                font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.soft;
                vertical-alignment: center;
            }
        }
        Text {
            x: parent.width - 130px; y: 17px; width: 61px; height: 30px;
            text: root.version-text;
            font-family: Font.mono; font-weight: Font.mono-weight; font-size: 12px; color: Pal.muted;
            horizontal-alignment: center; vertical-alignment: center;
        }
        Btn {
            x: parent.width - 60px; y: 16px; width: 32px; height: 32px;
            kind: 2;
            border-radius: 9px;
            has-icon: true;
            icon: Pal.dark ? @image-url("icons/moon.svg") : @image-url("icons/sun.svg");
            clicked => {
                Pal.dark = !Pal.dark;
                root.dark-mode-changed(Pal.dark);
            }
        }
    }

    // ================= Main: desktop strip + game cards =================
    if !root.touch && root.nav == 0: main-page := Flickable {
        x: 0; y: 65px; width: root.width; height: root.page-h;
        viewport-height: Math.max(self.height, root.note-y + 19px + 28px);

        // After a pick, scroll just enough to show the whole card, 16px clear
        // of the page edges.
        property <int> picked-serial: root.picked-serial;
        changed picked-serial => {
            if (root.picked-index >= 0) {
                self.show-card(root.picked-index);
            }
        }
        function show-card(i: int) {
            let top = root.grid-y + Math.floor(i / root.grid-cols) * 157px - 16px;
            let bottom = top + 146px + 32px;
            if (bottom > self.height - self.viewport-y) {
                self.viewport-y = self.height - bottom;
            }
            if (top < -self.viewport-y) {
                self.viewport-y = -top;
            }
            self.viewport-y = Math.min(0px, Math.max(self.height - self.viewport-height, self.viewport-y));
        }

        // Desktop vibrance strip. One control row (title, value, slider,
        // restore), the old Desktop page sentence under it in muted text.
        Rectangle {
            x: 30px; y: root.strip-y; width: parent.width - 60px; height: root.strip-h;
            background: Pal.surface;
            border-radius: 12px; border-width: 1px; border-color: Pal.line;
            property <length> row-mid: 40px;

            strip-title := Section {
                x: 24px; y: parent.row-mid - 17px; width: self.preferred-width; height: 34px;
                text: "Desktop vibrance"; font-size: 22px;
            }
            strip-value := Text {
                x: strip-title.x + strip-title.width + 24px; y: parent.row-mid - 22px; width: 104px; height: 44px;
                text: (root.default-percent > 0 ? "+" : "") + root.default-percent + "%";
                font-family: Font.head; font-weight: Font.head-weight; font-size: 32px; color: Pal.accent;
                letter-spacing: -0.6px;
                vertical-alignment: center;
            }
            VibSlider {
                x: strip-value.x + strip-value.width + 16px; y: parent.row-mid - 6px;
                width: parent.width - self.x - 24px - 232px - 32px;
                minimum: -100; maximum: 100;
                value: root.default-percent;
                changed(v) => { root.default-changed(v); }
                released(v) => { root.default-released(v); }
            }
            Btn {
                x: parent.width - 24px - 232px; y: parent.row-mid - 20px; width: 232px; height: 41px;
                kind: 2; font-size: 14px;
                text: "Restore desktop to normal";
                has-icon: true; icon: @image-url("icons/restore.svg");
                clicked => {
                    root.default-changed(0);
                    root.default-released(0);
                }
            }
            Text {
                x: 24px; y: 74px; width: parent.width - 48px; height: 18px;
                text: "Saturates your whole desktop, and games with no profile. A game whose profile is off shows normal colors. 0% leaves the desktop untouched.";
                font-family: Font.reg; font-weight: Font.reg-weight; font-size: 13px; color: Pal.muted;
                vertical-alignment: center; overflow: elide;
            }
        }

        Section {
            x: 30px; y: root.games-y; width: 400px; height: 37px;
            text: "Games"; font-size: 28px;
        }
        add-btn := Btn {
            x: parent.width - 30px - 145px; y: root.games-y; width: 145px; height: 37px;
            kind: 0;
            text: "Add game";
            has-icon: true; icon: @image-url("icons/plus.svg");
            has-trailing: true; trailing: @image-url("icons/down.svg");
            clicked => {
                root.steam-picker-opened();
                steam-popup.show();
            }
        }

        // The "Add game" list: the user's games by name, running ones first
        // (src/picker.rs), a filter field when the list is long, and one
        // plain sentence when there is nothing to list. The rows use the
        // Status page's two-line row (dot, bold name, muted detail) at a
        // height of 48px. Escape or a click outside closes it.
        property <length> steam-row-h: 48px;
        property <length> steam-list-y: root.steam-filter-shown ? 102px : 54px;
        property <length> steam-top: add-btn.y + add-btn.height + 6px;
        // Room below the button in the window, 16px clear of the bottom.
        property <length> steam-room: root.height - 65px - self.viewport-y - self.steam-top - 16px;
        property <length> steam-content: self.steam-list-y
            + (root.steam-rows.length == 0 ? 96px : root.steam-rows.length * self.steam-row-h) + 8px;
        steam-popup := PopupWindow {
            x: add-btn.x + add-btn.width - 400px;
            y: main-page.steam-top;
            width: 400px;
            // A long list keeps one height while the filter narrows it, so the
            // picker does not jump under the finger; a short one fits its rows.
            height: Math.max(150px, Math.min(main-page.steam-room,
                root.steam-filter-shown ? 440px : Math.min(440px, main-page.steam-content)));
            close-policy: close-on-click-outside;
            Rectangle {
                background: Pal.sheet;
                border-radius: 11px;
                border-width: 1px;
                border-color: Pal.line;
                Section {
                    x: 16px; y: 10px; width: parent.width - 118px; height: 31px;
                    text: "Your games"; font-size: 16px;
                }
                Btn {
                    x: parent.width - 86px; y: 12px; width: 70px; height: 27px;
                    kind: 2; border-radius: 6px; font-size: 12px;
                    text: "Refresh";
                    clicked => { root.steam-refresh(); }
                }
                Rectangle { x: 16px; y: 49px; width: parent.width - 32px; height: 1px; background: Pal.line; }

                // The app has no visible text field elsewhere; this one is drawn
                // with the outline button's tokens (radius, line, raised fill).
                if root.steam-filter-shown: Rectangle {
                    x: 16px; y: 58px; width: parent.width - 32px; height: 36px;
                    border-radius: 7px;
                    background: Pal.raised;
                    border-width: 1px;
                    border-color: filter-input.has-focus ? Pal.accent-line : Pal.line;
                    if filter-input.text == "": Text {
                        x: 12px; y: 0; width: parent.width - 24px; height: parent.height;
                        text: "Filter by name";
                        font-family: Font.med; font-weight: Font.med-weight; font-size: 13px; color: Pal.dim;
                        vertical-alignment: center;
                    }
                    filter-input := TextInput {
                        x: 12px; y: 0; width: parent.width - 24px; height: parent.height;
                        font-family: Font.med; font-weight: Font.med-weight; font-size: 13px; color: Pal.ink;
                        vertical-alignment: center;
                        single-line: true;
                        selection-background-color: Pal.accent-soft-2;
                        selection-foreground-color: Pal.ink;
                        init => { self.focus(); }
                        edited => { root.steam-filter-changed(self.text); }
                        accepted => {
                            if (root.steam-filter-accepted()) {
                                steam-popup.close();
                            }
                        }
                    }
                }

                if root.steam-rows.length == 0: Text {
                    x: 24px; y: main-page.steam-list-y; width: parent.width - 48px; height: 96px;
                    text: root.steam-message;
                    font-family: Font.med; font-weight: Font.med-weight; font-size: 13px; color: Pal.muted;
                    horizontal-alignment: center; vertical-alignment: center;
                    wrap: word-wrap;
                }
                steam-list := Flickable {
                    x: 8px; y: main-page.steam-list-y;
                    width: parent.width - 16px; height: parent.height - self.y - 8px;
                    viewport-height: Math.max(self.height, root.steam-rows.length * main-page.steam-row-h);
                    // Keyboard focus moving to a row scrolls it into view.
                    function show-row(i: int) {
                        let top = i * main-page.steam-row-h;
                        if (top + main-page.steam-row-h > self.height - self.viewport-y) {
                            self.viewport-y = self.height - top - main-page.steam-row-h;
                        }
                        if (top < -self.viewport-y) {
                            self.viewport-y = -top;
                        }
                    }
                    for game[i] in root.steam-rows: Rectangle {
                        x: 0; y: i * main-page.steam-row-h; width: parent.width; height: main-page.steam-row-h;
                        border-radius: 6px;
                        background: row-touch.has-hover ? Pal.raised : transparent;
                        border-width: row-focus.has-focus ? 1px : 0px;
                        border-color: Pal.accent-line;
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.pick-steam(i);
                                steam-popup.close();
                            }
                        }
                        row-focus := FocusScope {
                            focus-on-click: false;
                            focus-gained => { steam-list.show-row(i); }
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == " ") {
                                    root.pick-steam(i);
                                    steam-popup.close();
                                    return accept;
                                }
                                reject
                            }
                        }
                        Rectangle {
                            x: 9px; y: 14px; width: 7px; height: 7px; border-radius: 3.5px;
                            background: game.running || game.has-profile ? Pal.accent : Pal.dim;
                        }
                        Text {
                            x: 25px; y: 5px; width: parent.width - 33px; height: 20px;
                            text: game.name;
                            font-family: Font.bold; font-weight: Font.bold-weight; font-size: 13px; color: Pal.ink;
                            vertical-alignment: center; overflow: elide;
                        }
                        Text {
                            x: 25px; y: 24px; width: parent.width - 33px; height: 17px;
                            text: game.detail;
                            font-family: Font.med; font-weight: Font.med-weight; font-size: 12px;
                            color: game.running ? Pal.accent : Pal.muted;
                            vertical-alignment: center; overflow: elide;
                        }
                        if i < root.steam-rows.length - 1: Rectangle {
                            x: 8px; y: main-page.steam-row-h - 1px; width: parent.width - 16px; height: 1px;
                            background: Pal.line-soft;
                        }
                    }
                }
            }
        }

        if root.games.length == 0: Rectangle {
            x: 30px; y: root.grid-y; width: parent.width - 60px; height: 146px;
            background: Pal.surface;
            border-radius: 11px; border-width: 1px; border-color: Pal.line;
            Text {
                width: 100%; height: 100%;
                text: "No games yet.\nClick “Add game”, pick your game, and set its satur8.";
                font-family: Font.med; font-weight: Font.med-weight; font-size: 13px; color: Pal.muted;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }

        for game[i] in root.games: GameCard {
            x: 30px + Math.mod(i, root.grid-cols) * (root.card-w + 15px);
            y: root.grid-y + Math.floor(i / root.grid-cols) * 157px;
            width: root.card-w;
            game: game;
            picked: i == root.picked-index;
            percent-changed(v) => { root.percent-changed(i, v); }
            enabled-toggled(on) => { root.toggle-enabled(i, on); }
            remove-clicked => { root.remove(i); }
        }

        Image {
            x: 31px; y: root.note-y + 3px; width: 14px; height: 14px;
            source: @image-url("icons/info.svg"); colorize: Pal.dim;
        }
        Text {
            x: 52px; y: root.note-y; width: 879px; height: 19px;
            text: "Steam games are matched by their Steam app ID, other games by their executable name.";
            font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.muted;
            vertical-alignment: center;
        }
    }

    // ================= Status =================
    // Health (first), Right now, Settings, Help, and a compact Activity log.
    // Two columns share the render's 16px gutter; the page scrolls when the
    // window is shorter than the content.
    if !root.touch && root.nav == 1: status-page := Flickable {
        x: 0; y: 65px; width: root.width; height: root.page-h;
        property <length> left-w: Math.floor((self.width - 76px) * 0.58 / 1px) * 1px;
        property <length> right-x: 46px + self.left-w;
        property <length> right-w: self.width - 76px - self.left-w;
        property <length> top-h: 228px;
        property <length> mid-y: 24px + self.top-h + 16px;
        // Settings and Help share a row; it grows if the Help text wraps to
        // more lines on a narrow window, so the buttons never touch it.
        property <length> mid-h: Math.max(164px, help-para.y + help-para.height + 12px + 36px + 19px);
        property <length> act-y: self.mid-y + self.mid-h + 16px;
        viewport-height: Math.max(self.height, self.act-y + 159px + 28px);

        // ---------------- Health ----------------
        Rectangle {
            x: 30px; y: 24px; width: status-page.left-w; height: status-page.top-h;
            background: Pal.surface;
            border-radius: 12px; border-width: 1px; border-color: Pal.line;
            Section {
                x: 19px; y: 11px; width: 200px; height: 35px;
                text: "Health"; font-size: 23px;
            }
            check-btn := Btn {
                x: parent.width - 19px - self.width; y: 15px; width: 112px; height: 27px;
                kind: 2; border-radius: 6px; font-size: 12px;
                enabled: !root.checking && !root.repairing && !root.switch-busy;
                text: root.checking ? "Checking..." : "Check again";
                clicked => { root.check-health(); }
            }
            Btn {
                x: check-btn.x - 8px - self.width; y: 15px; width: 92px; height: 27px;
                kind: root.health-problem ? 0 : 2; border-radius: 6px; font-size: 12px;
                enabled: !root.checking && !root.repairing && !root.switch-busy;
                text: root.repairing ? "Repairing..." : "Repair";
                clicked => { root.repair(); }
            }
            Rectangle { x: 19px; y: 52px; width: parent.width - 38px; height: 1px; background: Pal.line; }
            for item[i] in root.health: Rectangle {
                x: 19px; y: 56px + i * 42px; width: parent.width - 38px; height: 42px;
                Rectangle {
                    x: 1px; y: 12px; width: 7px; height: 7px; border-radius: 3.5px;
                    background: item.level == 0 ? Pal.accent : item.level == 1 ? Pal.warn : Pal.dim;
                }
                Text {
                    x: 17px; y: 3px; width: parent.width - 17px; height: 20px;
                    text: item.label;
                    font-family: Font.bold; font-weight: Font.bold-weight; font-size: 13px;
                    color: item.level == 2 ? Pal.muted : Pal.ink;
                    vertical-alignment: center; overflow: elide;
                }
                Text {
                    x: 17px; y: 21px; width: parent.width - 17px; height: 17px;
                    text: item.detail;
                    font-family: Font.med; font-weight: Font.med-weight; font-size: 12px;
                    color: item.level == 1 ? Pal.warn : Pal.muted;
                    vertical-alignment: center; overflow: elide;
                }
                if i < root.health.length - 1: Rectangle {
                    x: 0; y: 41px; width: parent.width; height: 1px;
                    background: Pal.line-soft;
                }
            }
            if root.health.length == 0: Text {
                x: 19px; y: 56px; width: parent.width - 38px; height: 42px;
                text: "Checking...";
                font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.muted;
                vertical-alignment: center;
            }
        }

        // ---------------- Right now ----------------
        Rectangle {
            x: status-page.right-x; y: 24px; width: status-page.right-w; height: status-page.top-h;
            background: Pal.sheet;
            border-radius: 12px; border-width: 1px; border-color: Pal.line;
            Section {
                x: 19px; y: 11px; width: 200px; height: 35px;
                text: "Right now"; font-size: 23px;
            }
            // Small live marker: teal while the background service answers.
            Rectangle {
                x: parent.width - 19px - 7px; y: 25px; width: 7px; height: 7px; border-radius: 3.5px;
                background: root.live-daemon ? Pal.accent : Pal.dim;
            }
            Text {
                x: parent.width - 120px - 30px; y: 15px; width: 120px; height: 27px;
                text: root.live-daemon ? "live" : "service off";
                font-family: Font.mono; font-weight: Font.mono-weight; font-size: 11px; color: Pal.muted;
                horizontal-alignment: right; vertical-alignment: center;
            }
            Rectangle { x: 19px; y: 52px; width: parent.width - 38px; height: 1px; background: Pal.line; }

            // Saturation applied: always shown.
            Text {
                x: 19px; y: 62px; width: parent.width - 38px; height: 18px;
                text: "Saturation applied";
                font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.muted;
                vertical-alignment: center;
            }
            live-sat := Text {
                x: 19px; y: 80px; width: self.preferred-width; height: 32px;
                text: root.live-saturation;
                font-family: Font.head; font-weight: Font.head-weight; font-size: 24px; color: Pal.accent;
                vertical-alignment: center;
            }
            Text {
                x: live-sat.x + live-sat.width + 12px; y: 81px;
                width: parent.width - 19px - self.x; height: 32px;
                text: root.live-saturation-note;
                font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.muted;
                vertical-alignment: center; overflow: elide;
            }
            Rectangle { x: 19px; y: 120px; width: parent.width - 38px; height: 1px; background: Pal.line-soft; }

            if root.live-daemon: Rectangle {
                x: 19px; y: 126px; width: parent.width - 38px; height: 96px;
                Text {
                    x: 0; y: 2px; width: parent.width / 2; height: 18px;
                    text: "Active profile";
                    font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.muted;
                    vertical-alignment: center;
                }
                Text {
                    x: 0; y: 20px; width: parent.width / 2 - 8px; height: 24px;
                    text: root.live-profile;
                    font-family: Font.bold; font-weight: Font.bold-weight; font-size: 15px; color: Pal.ink;
                    vertical-alignment: center; overflow: elide;
                }
                if root.live-has-focused: Text {
                    x: parent.width / 2; y: 2px; width: parent.width / 2; height: 18px;
                    text: "Last focused window";
                    font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.muted;
                    vertical-alignment: center;
                }
                if root.live-has-focused: Text {
                    x: parent.width / 2; y: 20px; width: parent.width / 2; height: 24px;
                    text: root.live-focused;
                    font-family: Font.mono; font-weight: Font.mono-weight; font-size: 12px; color: Pal.soft;
                    vertical-alignment: center; overflow: elide;
                }
                Text {
                    x: 0; y: 54px; width: parent.width; height: 34px;
                    text: "Updates on its own every few seconds while this page is open.";
                    font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.dim;
                    wrap: word-wrap;
                }
            }
            if !root.live-daemon: Text {
                x: 19px; y: 130px; width: parent.width - 38px; height: 80px;
                text: "The background service is not running, so no game profile is active and nothing switches per game. The value above is the desktop setting.";
                font-family: Font.med; font-weight: Font.med-weight; font-size: 13px; color: Pal.soft;
                wrap: word-wrap;
            }
        }

        // ---------------- Settings ----------------
        Rectangle {
            x: 30px; y: status-page.mid-y; width: status-page.left-w; height: status-page.mid-h;
            background: Pal.sheet;
            border-radius: 12px; border-width: 1px; border-color: Pal.line;
            Section {
                x: 19px; y: 11px; width: 200px; height: 35px;
                text: "Settings"; font-size: 23px;
            }
            Rectangle { x: 19px; y: 52px; width: parent.width - 38px; height: 1px; background: Pal.line; }

            Text {
                x: 19px; y: 60px; width: parent.width - 90px; height: 20px;
                text: "Automatic per-game switching";
                font-family: Font.bold; font-weight: Font.bold-weight; font-size: 14px;
                color: root.switch-available ? Pal.ink : Pal.muted;
                vertical-alignment: center;
            }
            Text {
                x: 19px; y: 80px; width: parent.width - 90px; height: 17px;
                text: root.switch-busy ? "Applying..." : root.switch-detail;
                font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.muted;
                vertical-alignment: center; overflow: elide;
            }
            VibSwitch {
                x: parent.width - 19px - 32px; y: 69px;
                controlled: true;
                checked: root.switch-on;
                enabled: root.switch-available && !root.switch-busy && !root.checking && !root.repairing;
                toggled => { root.set-switching(!root.switch-on); }
            }
            Rectangle { x: 19px; y: 105px; width: parent.width - 38px; height: 1px; background: Pal.line-soft; }

            Text {
                x: 19px; y: 112px; width: 230px; height: 20px;
                text: "Starting saturation for new games";
                font-family: Font.bold; font-weight: Font.bold-weight; font-size: 14px; color: Pal.ink;
                vertical-alignment: center;
            }
            Text {
                x: 19px; y: 132px; width: 230px; height: 17px;
                text: "Used when you add a running game";
                font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.muted;
                vertical-alignment: center;
            }
            new-game-slider := VibSlider {
                x: parent.width - 19px - self.width; y: 120px;
                width: Math.max(150px, parent.width - 19px - 250px - 64px - 12px);
                minimum: -100; maximum: 100;
                value: root.new-game-percent;
                changed(v) => { root.new-game-changed(v); }
                released(v) => { root.new-game-released(v); }
            }
            Text {
                x: new-game-slider.x - 12px - 60px; y: 112px; width: 60px; height: 28px;
                text: (root.new-game-percent > 0 ? "+" : "") + root.new-game-percent + "%";
                font-family: Font.head; font-weight: Font.head-weight; font-size: 18px; color: Pal.accent;
                horizontal-alignment: right; vertical-alignment: center;
            }
        }

        // ---------------- Help ----------------
        Rectangle {
            x: status-page.right-x; y: status-page.mid-y; width: status-page.right-w; height: status-page.mid-h;
            background: Pal.sheet;
            border-radius: 12px; border-width: 1px; border-color: Pal.line;
            Section {
                x: 19px; y: 11px; width: 200px; height: 35px;
                text: "Help"; font-size: 23px;
            }
            Rectangle { x: 19px; y: 52px; width: parent.width - 38px; height: 1px; background: Pal.line; }
            help-para := Text {
                x: 19px; y: 60px; width: parent.width - 38px;
                text: "System info is your Satur8 version, desktop, GPU and the checks above, without your home folder, user or computer name. Report a bug copies it for you to paste; nothing is sent.";
                font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.muted;
                wrap: word-wrap;
            }
            // Holds the system info text for the clipboard (Slint's own
            // clipboard, the same one Ctrl+C in a text field uses).
            sysinfo-input := TextInput {
                x: 0; y: 0; width: 1px; height: 1px;
                opacity: 0;
                read-only: true;
                text: root.sysinfo-text;
            }
            copy-btn := Btn {
                x: 19px; y: parent.height - 19px - 36px;
                width: (parent.width - 38px - 10px) / 2; height: 36px;
                kind: 1;
                text: "Copy system info";
                enabled: root.sysinfo-text != "";
                clicked => {
                    sysinfo-input.select-all();
                    sysinfo-input.copy();
                    sysinfo-input.clear-selection();
                    root.sysinfo-copied();
                }
            }
            Btn {
                x: copy-btn.x + copy-btn.width + 10px; y: copy-btn.y;
                width: copy-btn.width; height: 36px;
                kind: 2;
                text: "Report a bug";
                has-trailing: true; trailing: @image-url("icons/external.svg");
                clicked => {
                    // Copy first: the report page opens empty of machine details.
                    if (root.sysinfo-text != "") {
                        sysinfo-input.select-all();
                        sysinfo-input.copy();
                        sysinfo-input.clear-selection();
                    }
                    root.report-bug();
                }
            }
        }

        // ---------------- Activity (compact) ----------------
        Rectangle {
            x: 30px; y: status-page.act-y; width: parent.width - 60px;
            height: status-page.viewport-height - status-page.act-y - 28px;
            background: Pal.sheet;
            border-radius: 12px; border-width: 1px; border-color: Pal.line;
            Section {
                x: 19px; y: 7px; width: 200px; height: 30px;
                text: "Activity"; font-size: 20px;
            }
            Btn {
                x: parent.width - 74px; y: 9px; width: 55px; height: 27px;
                kind: 2; border-radius: 6px; font-size: 12px;
                text: "Clear";
                clicked => { root.clear-activity(); }
            }
            Rectangle { x: 19px; y: 43px; width: parent.width - 38px; height: 1px; background: Pal.line; }
            if root.activity.length == 0: Text {
                x: 19px; y: 47px; width: parent.width - 38px; height: parent.height - 55px;
                text: "No activity yet. Checks, repairs and profile changes show up here.";
                font-family: Font.med; font-weight: Font.med-weight; font-size: 12px; color: Pal.muted;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Flickable {
                x: 19px; y: 47px; width: parent.width - 38px; height: parent.height - 55px;
                viewport-height: Math.max(self.height, root.activity.length * 35px);
                for entry[i] in root.activity: Rectangle {
                    x: 0; y: i * 35px; width: parent.width; height: 35px;
                    Rectangle {
                        x: 1px; y: 14px; width: 6px; height: 6px; border-radius: 3px;
                        background: entry.ok ? Pal.accent : Pal.dim;
                    }
                    Text {
                        x: 17px; y: 0; width: parent.width - 130px; height: 34px;
                        text: entry.text;
                        font-family: Font.med; font-weight: Font.med-weight; font-size: 13px; color: Pal.soft;
                        vertical-alignment: center; overflow: elide;
                    }
                    Text {
                        x: parent.width - 106px; y: 0; width: 103px; height: 34px;
                        text: entry.time;
                        font-family: Font.mono; font-weight: Font.mono-weight; font-size: 11px; color: Pal.muted;
                        horizontal-alignment: right; vertical-alignment: center;
                    }
                    if i < root.activity.length - 1: Rectangle {
                        x: 0; y: 33px; width: parent.width; height: 1px;
                        background: Pal.line-soft;
                    }
                }
            }
        }
    }

    // ================= About (directions.py:52-65) =================
    // Render layout, with the old Desktop page's "Auto-apply per game" card
    // added as a third card in the middle row. Cards grow if text wraps.
    if !root.touch && root.nav == 2: about-page := Flickable {
        x: 0; y: 65px; width: root.width; height: root.page-h;
        property <length> col-w: Math.floor((self.width - 60px - 32px) / 3 / 1px) * 1px;
        property <length> cards-y: intro-card.y + intro-card.height + 16px;
        property <length> cards-h: Math.max(237px, Math.max(why2.y + why2.height + 30px,
            Math.max(auto2.y + auto2.height + 30px, rust-text.y + rust-text.height + 30px)));
        property <length> links-y: self.cards-y + self.cards-h + 16px;
        viewport-height: Math.max(self.height, self.links-y + 102px + 32px);

        Heading {
            x: 31px; y: 18px; width: 650px; height: 50px;
            text: "About"; font-size: 39px;
        }

        intro-card := Rectangle {
            x: 30px; y: 86px; width: parent.width - 60px;
            height: Math.max(146px, intro-text.height + 42px);
            background: Pal.surface;
            border-radius: 12px; border-width: 1px; border-color: Pal.line;
            Image {
                x: 27px; y: parent.height / 2 - 26px; width: 288px; height: 57px;
                source: Pal.dark ? @image-url("word.png") : @image-url("word-light.png");
                image-fit: fill;
            }
            Rectangle { x: 367px; y: parent.height / 2 - 45px; width: 1px; height: 90px; background: Pal.line; }
            intro-text := Para {
                x: 400px; y: 21px; width: parent.width - 454px;
                text: "Per-game digital vibrance for Linux. Satur8 watches focused game windows, applies the matching saturation profile, and restores your desktop setting when you leave the game.";
                font-family: Font.med; font-weight: Font.med-weight; font-size: 20px;
            }
        }

        Rectangle {
            x: 30px; y: about-page.cards-y; width: about-page.col-w; height: about-page.cards-h;
            background: Pal.sheet;
            border-radius: 12px; border-width: 1px; border-color: Pal.line;
            Section {
                x: 22px; y: 17px; width: parent.width - 44px; height: 37px;
                text: "Why it is different"; font-size: 25px;
            }
            why1 := Para {
                x: 23px; y: 66px; width: parent.width - 45px;
                text: "Satur8 changes the display color pipeline after the game renders. It does not inject into, read, or modify the game process.";
                font-size: 14px;
            }
            why2 := Para {
                x: 23px; y: why1.y + why1.height + 12px; width: parent.width - 45px;
                text: "That makes it a cleaner fit for games with trusted or anti-cheat modes than shader injectors like vkBasalt or ReShade-style tools.";
                font-size: 14px; color: Pal.muted;
            }
        }

        // Moved here from the old Desktop page (directions.py:47-49).
        Rectangle {
            x: 30px + about-page.col-w + 16px; y: about-page.cards-y;
            width: about-page.col-w; height: about-page.cards-h;
            background: Pal.sheet;
            border-radius: 12px; border-width: 1px; border-color: Pal.line;
            Section {
                x: 22px; y: 17px; width: parent.width - 44px; height: 37px;
                text: "Auto-apply per game"; font-size: 25px;
            }
            auto1 := Para {
                x: 23px; y: 66px; width: parent.width - 45px;
                text: "Satur8 watches the focused game window and applies the matching profile automatically. No Steam launch options are required.";
                font-size: 14px;
            }
            auto2 := Para {
                x: 23px; y: auto1.y + auto1.height + 12px; width: parent.width - 45px;
                text: "When you leave the game, Satur8 restores your desktop vibrance setting.";
                font-size: 14px; color: Pal.muted;
            }
        }

        Rectangle {
            x: 30px + 2 * (about-page.col-w + 16px); y: about-page.cards-y;
            width: parent.width - 60px - 2 * (about-page.col-w + 16px); height: about-page.cards-h;
            background: Pal.sheet;
            border-radius: 12px; border-width: 1px; border-color: Pal.line;
            Section {
                x: 22px; y: 17px; width: parent.width - 44px; height: 37px;
                text: "Built in Rust"; font-size: 25px;
            }
            rust-text := Para {
                x: 23px; y: 66px; width: parent.width - 45px;
                text: "The CLI, GUI, daemon, tray, profile model, and backends are written in Rust so the app stays native, small, and event-driven with no garbage collector running while you play.";
                font-size: 14px;
            }
        }

        Rectangle {
            x: 30px; y: about-page.links-y; width: parent.width - 60px; height: 102px;
            background: Pal.surface;
            border-radius: 12px; border-width: 1px; border-color: Pal.line;
            Section {
                x: 23px; y: 29px; width: 202px; height: 35px;
                text: "Links"; font-size: 23px;
            }
            github := Btn {
                x: parent.width - 335px; y: 31px; width: 308px; height: 38px;
                kind: 2; font-size: 14px;
                text: "GitHub  NtrpyDev/satur8";
                has-trailing: true; trailing: @image-url("icons/external.svg");
                clicked => { root.open-link("https://github.com/NtrpyDev/satur8"); }
            }
            twitter := Btn {
                x: github.x - 277px; y: 31px; width: 263px; height: 38px;
                kind: 2; font-size: 14px;
                text: "Twitter / X  @NtrpyDev";
                has-trailing: true; trailing: @image-url("icons/external.svg");
                clicked => { root.open-link("https://x.com/NtrpyDev"); }
            }
            Btn {
                x: twitter.x - 168px; y: 31px; width: 155px; height: 38px;
                kind: 3; font-size: 14px;
                text: "satur8.app";
                has-trailing: true; trailing: @image-url("icons/external.svg");
                clicked => { root.open-link("https://satur8.app"); }
            }
        }
    }
    // ================= Steam Game Mode =================
    if root.touch: GameModeUi {
        x: 0; y: 0; width: root.width; height: root.height;
        backend-name: root.backend-name;
        backend-ok: root.backend-ok;
        version-text: root.version-text;
        health: root.health;
        health-problem: root.health-problem;
        checking: root.checking;
        repairing: root.repairing;
        switch-available: root.switch-available;
        switch-on: root.switch-on;
        switch-busy: root.switch-busy;
        switch-detail: root.switch-detail;
        live-daemon: root.live-daemon;
        live-profile: root.live-profile;
        live-saturation: root.live-saturation;
        live-saturation-note: root.live-saturation-note;
        live-color-off: root.live-color-off;
        new-game-percent: root.new-game-percent;
        sysinfo-text: root.sysinfo-text;
        activity: root.activity;
        check-health => { root.check-health(); }
        repair => { root.repair(); }
        set-switching(on) => { root.set-switching(on); }
        sysinfo-copied => { root.sysinfo-copied(); }
        report-bug => { root.report-bug(); }
        open-link(url) => { root.open-link(url); }
        dark-mode-changed(dark) => { root.dark-mode-changed(dark); }
    }
}
