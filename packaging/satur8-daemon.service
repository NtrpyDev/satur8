[Unit]
Description=Satur8 focus daemon (per-game digital vibrance)
Documentation=https://github.com/NtrpyDev/satur8
# Only meaningful inside a graphical session.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# KWin only loads an effect built for its exact version. Check that at session
# start and, if a KWin update stranded it, install the matching effect from the
# bundled set or rebuild it where build tools exist. Never fatal.
ExecStartPre=-%h/.local/bin/satur8 repair
ExecStart=%h/.local/bin/satur8-daemon
Restart=on-failure
RestartSec=2
# Event-driven: it sleeps until the KWin script forwards a focus change, or, in
# Steam Game Mode, until gamescope's focused-app property changes.

[Install]
WantedBy=graphical-session.target
